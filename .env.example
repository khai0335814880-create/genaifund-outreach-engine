# ==============================================================================
# GenAI Fund — Forward Deployed Engineer Assignment Configuration Template
# NOTE: For offline/dry-run evaluation, you do NOT need to fill any API keys!
# The app will automatically run in Mock Mode with sample datasets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. X (Twitter) API v2 Credentials (OAuth 1.0a User Context for Sender Account)
# Required only if executing LIVE DM dispatches or LIVE search.
# Obtain from: https://developer.x.com (App Permissions: Read + Write + Direct Message)
# ------------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 2. LLM Provider (OpenAI-compatible endpoint)
# Supports: OpenAI (gpt-4o-mini), Groq, OpenRouter, DeepSeek, or local Ollama.
# If left blank, the app uses deterministic keyword-grounded mock scoring.
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                  # Leave blank for default OpenAI (https://api.openai.com/v1)

# ------------------------------------------------------------------------------
# 3. Safety Invariants & Outbound Guards (CRITICAL)
# TEST_MODE=true strictly blocks message dispatches to anyone not in ALLOWED_RECIPIENTS.
# ------------------------------------------------------------------------------
TEST_MODE=true
ALLOWED_RECIPIENTS=your_test_account,friend_who_agreed

# Hard rate & cost caps
DAILY_SEND_CAP=10              # Max outbound DMs allowed per calendar day
MAX_X_SPEND_USD=5.0            # Hard ceiling on X pay-per-use spend per session
SEND_DELAY_MIN_S=30            # Random delay floor between bulk batch dispatches (seconds)
SEND_DELAY_MAX_S=90            # Random delay ceiling between bulk batch dispatches (seconds)

# ------------------------------------------------------------------------------
# 4. Local Database Persistence
# ------------------------------------------------------------------------------
DB_PATH=outreach.db
